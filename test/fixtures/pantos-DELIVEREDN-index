	var xfn_nvl = function(pVal){ return (pVal == null || pVal == '')?'{}':pVal; }

	var decodeXSS = function(json){
        for(key in json) {
            var value = String(json[key]);
            json[key] = Array(value.replace(/&lt;/g,"<").replace(/&gt;/g,">").replace(/&#39;/g,"'").replace(/&#40;/g,"(").replace(/&#41;/g,")"));
        }

        return json;
    }

