    <script type="text/javascript">
      // This is because angular thinks skip to content anchor tag <a href="#track_package" class="skip-nav" target="_self"> is to a angular route  so we are adding this to prevent default behaviour and focus on the first element
      $(document).ready(function(e) {
        var giveUpCounter = 0;
        var checkSkipNav = setInterval(function() {
          if ($(".skip-nav").length) {
            $(".skip-nav").on("click", function(event) {
              event.preventDefault();
              if (document.querySelector("#search_result") !== null) {
                document.querySelector("#search_result").focus();
              } else if (
                document.querySelector("#search_result_list") !== null
              ) {
                document.querySelector("#search_result_list").focus();
              } else if (document.querySelector("#search-package") !== null) {
                document.querySelector("#search-package").focus();
              }
            });
            clearInterval(checkSkipNav);
          } else if (giveUpCounter > 99) {
            clearInterval(checkSkipNav);
          } else {
            giveUpCounter += 1;
          }
        }, 100);
      });
    </script>
