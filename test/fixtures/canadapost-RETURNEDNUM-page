        // Preserve query params outside the hash
        if (location.search) {
          if (newUrl.includes('?')) {
            newUrl += '&' + location.search.substring(1);
          } else {
            newUrl += location.search;
          }
        }
        location.replace(newUrl);
      }
    })();
